<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — دانشگاه حضرت معصومه (س)</title>
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.rtl.min.css" />
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            min-height: 100vh;
            background: linear-gradient(160deg, #0a2e1a 0%, #1a5c3a 55%, #0d3b24 100%);
            font-family: 'Tahoma', 'Segoe UI', sans-serif;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            position: relative;
            overflow: hidden;
        }

        /* دایره‌های تزئینی پس‌زمینه */
        body::before {
            content: '';
            position: absolute;
            width: 500px; height: 500px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(255,255,255,0.05) 0%, transparent 70%);
            top: -150px; right: -150px;
        }
        body::after {
            content: '';
            position: absolute;
            width: 400px; height: 400px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(255,255,255,0.04) 0%, transparent 70%);
            bottom: -100px; left: -100px;
        }

        .auth-wrapper {
            position: relative;
            z-index: 1;
            width: 100%;
            max-width: 450px;
        }

        .auth-card {
            background: #ffffff;
            border-radius: 28px;
            box-shadow:
                0 32px 64px rgba(0,0,0,0.45),
                0 0 0 1px rgba(255,255,255,0.08);
            padding: 2.8rem 2.4rem 2rem;
            animation: slideUp 0.5s cubic-bezier(0.16, 1, 0.3, 1);
        }

        @@keyframes slideUp {
            from { opacity: 0; transform: translateY(40px) scale(0.97); }
            to   { opacity: 1; transform: translateY(0) scale(1); }
        }

        /* ─── هدر دانشگاه ─── */
        .univ-header { text-align: center; margin-bottom: 1.8rem; }

        .univ-emblem {
            width: 96px; height: 96px;
            background: linear-gradient(145deg, #1d6e47, #2ea86a);
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            margin: 0 auto 14px;
            box-shadow: 0 10px 28px rgba(26,92,58,0.45);
            position: relative;
            animation: emblemPulse 3s ease-in-out infinite;
        }

        .univ-emblem::before {
            content: '';
            position: absolute;
            inset: -4px;
            border-radius: 50%;
            border: 2px dashed rgba(46,168,106,0.4);
            animation: rotate 12s linear infinite;
        }

        @@keyframes emblemPulse {
            0%,100% { box-shadow: 0 10px 28px rgba(26,92,58,0.45); }
            50%      { box-shadow: 0 10px 40px rgba(26,92,58,0.65); }
        }

        @@keyframes rotate {
            from { transform: rotate(0deg); }
            to   { transform: rotate(360deg); }
        }

        .emblem-icon { font-size: 2.6rem; line-height: 1; }

        .univ-name {
            font-size: 1.22rem;
            font-weight: 700;
            color: #1a5c3a;
            margin-bottom: 4px;
            letter-spacing: 0.3px;
        }

        .univ-sub {
            font-size: 0.8rem;
            color: #9ca3af;
            letter-spacing: 0.5px;
        }

        .gold-divider {
            height: 2px;
            background: linear-gradient(to right, transparent, #c9920f 30%, #e8b80d 50%, #c9920f 70%, transparent);
            border: none;
            margin: 1.6rem 0;
            opacity: 0.6;
        }

        /* ─── فرم ─── */
        .field-label {
            display: block;
            font-size: 0.85rem;
            font-weight: 600;
            color: #374151;
            margin-bottom: 8px;
        }

        .input-phone {
            width: 100%;
            font-size: 1.5rem;
            font-weight: 700;
            text-align: center;
            letter-spacing: 6px;
            border: 2px solid #e5e7eb;
            border-radius: 16px;
            padding: 14px 12px;
            color: #1a5c3a;
            background: #fafafa;
            direction: ltr;
            transition: all 0.25s;
            outline: none;
        }

        .input-phone:focus {
            border-color: #1a5c3a;
            box-shadow: 0 0 0 4px rgba(26,92,58,0.1);
            background: #fff;
        }

        .btn-main {
            display: block;
            width: 100%;
            background: linear-gradient(135deg, #1a5c3a, #2ea86a);
            color: #fff;
            border: none;
            border-radius: 16px;
            padding: 15px;
            font-size: 1rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s;
            letter-spacing: 0.5px;
            position: relative;
            overflow: hidden;
        }

        .btn-main::after {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, transparent 40%, rgba(255,255,255,0.15) 100%);
        }

        .btn-main:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 28px rgba(26,92,58,0.42);
        }

        .btn-main:active { transform: translateY(0); }

        /* ─── OTP جعبه‌ها ─── */
        .otp-label {
            text-align: center;
            color: #4b5563;
            font-size: 0.88rem;
            margin-bottom: 0.5rem;
        }

        .phone-pill {
            display: inline-block;
            background: #f0fdf4;
            border: 1.5px solid #86efac;
            border-radius: 25px;
            padding: 5px 16px;
            color: #1a5c3a;
            font-weight: 700;
            font-size: 0.9rem;
            direction: ltr;
            letter-spacing: 2px;
        }

        .otp-boxes {
            display: flex;
            gap: 9px;
            justify-content: center;
            direction: ltr;
            margin: 1.6rem 0 1.4rem;
        }

        .otp-box {
            width: 56px;
            height: 68px;
            text-align: center;
            font-size: 2rem;
            font-weight: 800;
            border: 2.5px solid #e5e7eb;
            border-radius: 16px;
            color: #1a5c3a;
            background: #f9fafb;
            caret-color: transparent;
            outline: none;
            transition: border-color 0.2s, box-shadow 0.2s, transform 0.15s, background 0.2s;
            animation: boxIn 0.4s cubic-bezier(0.16,1,0.3,1) backwards;
        }

        @@keyframes boxIn {
            from { opacity: 0; transform: translateY(12px) scale(0.9); }
            to   { opacity: 1; transform: translateY(0) scale(1); }
        }

        .otp-box:focus {
            border-color: #1a5c3a;
            background: #fff;
            box-shadow: 0 0 0 4px rgba(26,92,58,0.14);
            transform: scale(1.06);
        }

        .otp-box.filled {
            border-color: #22c55e;
            background: #f0fdf4;
        }

        /* ─── تایمر ─── */
        .timer-wrap { text-align: center; margin-bottom: 1.5rem; }

        .timer-ring {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 22px;
            border-radius: 30px;
            font-size: 1rem;
            font-weight: 700;
            transition: all 0.4s;
        }

        .timer-active {
            background: #f0fdf4;
            border: 2px solid #86efac;
            color: #16a34a;
        }

        .timer-expired {
            background: #fef2f2;
            border: 2px solid #fca5a5;
            color: #dc2626;
            animation: shake 0.4s ease;
        }

        @@keyframes shake {
            0%,100%{ transform:translateX(0) }
            20%    { transform:translateX(-4px) }
            60%    { transform:translateX(4px) }
        }

        /* ─── دکمه ارسال مجدد ─── */
        .btn-resend {
            display: block;
            width: 100%;
            background: none;
            border: 2px dashed #e5e7eb;
            color: #d1d5db;
            border-radius: 14px;
            padding: 12px;
            font-size: 0.9rem;
            font-weight: 600;
            cursor: not-allowed;
            transition: all 0.3s;
            margin-top: 10px;
        }

        .btn-resend.ready {
            border-color: #1a5c3a;
            color: #1a5c3a;
            cursor: pointer;
            background: #f0fdf4;
        }

        .btn-resend.ready:hover { background: #dcfce7; transform: translateY(-1px); }

        /* ─── متفرقه ─── */
        .alert-custom {
            border-radius: 12px;
            font-size: 0.87rem;
            padding: 10px 14px;
            border: none;
            background: #fef2f2;
            color: #b91c1c;
            margin-bottom: 1rem;
        }

        .back-link {
            display: block;
            text-align: center;
            margin-top: 1.2rem;
            color: #9ca3af;
            font-size: 0.82rem;
            text-decoration: none;
            transition: color 0.2s;
        }
        .back-link:hover { color: #1a5c3a; }

        .footer-note {
            text-align: center;
            color: #d1d5db;
            font-size: 0.76rem;
            margin-top: 1.4rem;
        }
    </style>
</head>
<body>
<div class="auth-wrapper">
    @RenderBody()
</div>
<script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
