@model List<SsoServer.Controllers.AppCard>
@{
    ViewData["Title"] = "ورود موفق";
    Layout = "_AuthLayout";
    var hmu = Model.FirstOrDefault(a => a.ClientId == "hmu-web");
}

<style>
    .success-card {
        text-align: center;
    }

    .check-circle {
        width: 72px; height: 72px;
        background: linear-gradient(135deg, #16a34a, #22c55e);
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        margin: 0 auto 1.2rem;
        box-shadow: 0 8px 24px rgba(22,163,74,0.35);
        animation: popIn 0.5s cubic-bezier(0.16,1,0.3,1);
    }

    @@keyframes popIn {
        from { transform: scale(0.5); opacity: 0; }
        to   { transform: scale(1);   opacity: 1; }
    }

    .check-circle svg {
        width: 36px; height: 36px;
        stroke: #fff;
        stroke-width: 3;
        fill: none;
    }

    .success-title {
        font-size: 1.3rem;
        font-weight: 800;
        color: #111827;
        margin-bottom: 0.4rem;
    }

    .success-sub {
        font-size: 0.84rem;
        color: #6b7280;
        margin-bottom: 2rem;
    }

    .user-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #f0fdf4;
        border: 1.5px solid #86efac;
        border-radius: 30px;
        padding: 7px 18px;
        font-size: 0.88rem;
        color: #15803d;
        font-weight: 600;
        margin-bottom: 2rem;
        direction: ltr;
    }

    .user-pill::before {
        content: '';
        width: 8px; height: 8px;
        background: #22c55e;
        border-radius: 50%;
    }

    .btn-profile {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        width: 100%;
        background: linear-gradient(135deg, #1a3a8f 0%, #2348ba 100%);
        color: #fff;
        border: none;
        border-radius: 16px;
        padding: 16px 20px;
        font-size: 1rem;
        font-weight: 700;
        text-decoration: none;
        cursor: pointer;
        transition: transform 0.25s, box-shadow 0.25s;
        box-shadow: 0 6px 22px rgba(26,58,143,0.38);
        margin-bottom: 1rem;
    }

    .btn-profile:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 32px rgba(26,58,143,0.52);
        color: #fff;
        text-decoration: none;
    }

    .sso-footer {
        text-align: center;
        font-size: 0.75rem;
        color: #9ca3af;
        margin-top: 0.5rem;
    }
</style>

<div class="auth-card success-card">

    <div class="check-circle">
        <svg viewBox="0 0 24 24">
            <polyline points="20 6 9 17 4 12"/>
        </svg>
    </div>

    <div class="success-title">ورود با موفقیت انجام شد</div>
    <div class="success-sub">هویت شما از طریق درگاه دولت تأیید شد</div>

    @{
        var phone = User.FindFirst("phone_number")?.Value
                 ?? User.FindFirst(System.Security.Claims.ClaimTypes.MobilePhone)?.Value
                 ?? User.FindFirst("sub")?.Value;
    }
    @if (!string.IsNullOrEmpty(phone))
    {
        <div class="user-pill">@phone</div>
    }

    <a class="btn-profile" href="https://hmu.ac.ir/profile">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
             xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"
                  stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
            <polyline points="9 22 9 12 15 12 15 22"
                      stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
        </svg>
        بازگشت به پروفایل
    </a>

    <form method="post" action="/Account/Logout" style="margin:0">
        @Html.AntiForgeryToken()
        <button type="submit" style="background:none;border:none;color:#9ca3af;font-size:0.78rem;cursor:pointer;width:100%;padding:6px 0;margin-top:4px">
            خروج از حساب
        </button>
    </form>

    <div class="sso-footer">سامانه یکپارچه احراز هویت — دانشگاه حضرت معصومه (س)</div>
</div>
