@model LoginViewModel
@{
    ViewData["Title"] = "ورود به سامانه";
    Layout = "_AuthLayout";
}

<div class="auth-card">

    <div class="univ-header">
        <div class="univ-emblem">
            <img src="~/images/logo.png"
                 alt="لوگوی دانشگاه حضرت معصومه"
                 onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
            <div class="emblem-fallback">🏛</div>
        </div>
        <div class="univ-name">دانشگاه حضرت معصومه (س)</div>
        <div class="univ-sub">سامانه یکپارچه احراز هویت</div>
    </div>

    <hr class="gold-divider" />

    @if (ViewData["Error"] != null)
    {
        <div class="alert-custom" style="margin-bottom:1.2rem">⚠ @ViewData["Error"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert-custom" style="margin-bottom:1.2rem">⚠ @TempData["Error"]</div>
    }

    <div asp-validation-summary="All" class="alert-custom" style="margin-bottom:1.2rem"></div>

    <!-- روش اول: ورود با شماره موبایل -->
    <form asp-action="Login" method="post" id="loginForm">
        <input type="hidden" asp-for="ReturnUrl" />

        <label class="field-label" asp-for="PhoneNumber">نام کاربری (شماره موبایل)</label>
        <input asp-for="PhoneNumber" class="input-phone" type="tel" inputmode="numeric"
               maxlength="11" placeholder="09123456789" autocomplete="username" autofocus />

        <button type="submit" class="btn-main" style="margin-top:1.2rem">ادامه</button>
    </form>

    <div style="text-align:center; margin:1rem 0; color:#9ca3af; font-size:0.85rem;">
        ── یا ──
    </div>

    <!-- روش دوم: درگاه دولت -->
    <p class="gov-hint">برای ورود از حساب کاربری درگاه ملی خدمات دولت استفاده کنید</p>

    <a class="btn-gov"
       href="/external/msrt/login?returnUrl=@Uri.EscapeDataString(Model.ReturnUrl ?? "")">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
             xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <rect x="2" y="3" width="20" height="18" rx="2" stroke="currentColor" stroke-width="1.8"/>
            <path d="M8 3v18M12 3v18M16 3v18" stroke="currentColor" stroke-width="1.4" opacity=".5"/>
            <path d="M2 9h20M2 15h20" stroke="currentColor" stroke-width="1.4" opacity=".5"/>
        </svg>
        ورود با درگاه دولت
        <span class="gov-chip">وزارت علوم</span>
    </a>

    <p class="footer-note">با ورود، قوانین و مقررات دانشگاه حضرت معصومه را می‌پذیرید</p>
</div>

@section Scripts {
<script>
(function () {
    const params = new URLSearchParams(location.search);
    const err = params.get('error');
    const msgs = {
        msrt_nocode:   'درگاه دولت کد احراز هویت ارسال نکرد.',
        msrt_state:    'درخواست نامعتبر — لطفاً دوباره تلاش کنید.',
        msrt_token:    'دریافت توکن از درگاه دولت ناموفق بود.',
        msrt_userinfo: 'دریافت اطلاعات کاربر از درگاه دولت ناموفق بود.',
        msrt_create:   'ساخت حساب کاربری ناموفق بود — با پشتیبانی تماس بگیرید.',
    };
    if (err && msgs[err]) {
        const div = document.createElement('div');
        div.className = 'alert-custom';
        div.style.marginBottom = '1.2rem';
        div.textContent = '⚠ ' + msgs[err];
        document.querySelector('.btn-gov').before(div);
    }
})();
</script>
}
